{
  "name": "robotshift-functions",
  "private": true,
  "main": "lib/index.js",
  "type": "module",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "generate:context": "cd .. && node --import tsx scripts/generate-tutor-context.mts",
    "build": "npm run generate:context && tsc",
    "test": "npm run build && node --test --test-concurrency=1 test/server-core.test.js",
    "test:emulator:inside": "node --test --test-concurrency=1 test/emulator-contracts.test.js"
  },
  "dependencies": {
    "@google/genai": "2.13.0",
    "firebase-admin": "14.2.0",
    "firebase-functions": "7.3.0"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "typescript": "5.9.3"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
