# Robot/Shift requires no local runtime secrets.
#
# Firebase web configuration and the reCAPTCHA Enterprise site key are public
# app identifiers committed in app/firebase-client.ts. Never place a service
# account key, App Check debug token, or Gemini API key in this file.
#
# Optional local QA only. The code also requires a localhost hostname before it
# connects to the Firebase Emulator Suite.
NEXT_PUBLIC_FIREBASE_EMULATORS=false
